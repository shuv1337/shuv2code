# Optional: shuv2code connect source builds
# Leave these unset to disable optional shuv2code connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# These are public identifiers, not secrets. Get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# SHUV2CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# SHUV2CODE_CLERK_JWT_TEMPLATE=shuv2code-relay
# SHUV2CODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in SHUV2CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# SHUV2CODE_APPLE_TEAM_ID=ABC1234567
# SHUV2CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/shuv2code.provisionprofile
# SHUV2CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# SHUV2CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# It has no default; setting it explicitly enables hosted pairing and OAuth URLs.
# SHUV2CODE_HOSTED_APP_URL=https://app.shuv2code.example

# Optional: anonymous installation-scoped product telemetry. Telemetry remains disabled
# unless SHUV2CODE_TELEMETRY_ENABLED is true and SHUV2CODE_POSTHOG_KEY is non-empty.
# The PostHog host defaults to https://us.i.posthog.com when omitted.
# SHUV2CODE_TELEMETRY_ENABLED=true
# SHUV2CODE_POSTHOG_KEY=phc_...
# SHUV2CODE_POSTHOG_HOST=https://us.i.posthog.com

# Public, ingest-only mobile OpenTelemetry configuration.
# SHUV2CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# SHUV2CODE_MOBILE_OTLP_TRACES_DATASET=shuv2code-mobile-traces-dev
# SHUV2CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
