{
  "name": "shuv2code",
  "version": "0.1.1-alpha.2",
  "description": "Local-first coding agent server and CLI for shuv2code",
  "keywords": [
    "cli",
    "coding-agent",
    "devtools",
    "shuv2code"
  ],
  "homepage": "https://github.com/shuv1337/shuv2code",
  "bugs": {
    "url": "https://github.com/shuv1337/shuv2code/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuv1337/shuv2code.git",
    "directory": "apps/server"
  },
  "bin": {
    "s2c": "./dist/bin.mjs",
    "shuv2code": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build:bundle": "vp pack && vp pack src/service-launcher.ts --out-dir dist --no-clean",
    "start": "node dist/bin.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "msgpackr-extract": "3.0.4",
    "node-pty": "^1.1.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@shuv2code/contracts": "workspace:*",
    "@shuv2code/shared": "workspace:*",
    "@shuv2code/tailscale": "workspace:*",
    "@shuv2code/web": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
