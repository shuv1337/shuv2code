---
import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["license", "Open-source license"],
  ["your-responsibility", "Your responsibility"],
  ["third-parties", "Third-party services"],
  ["alpha", "Alpha software"],
  ["provenance", "Project provenance"],
] as const;
---

<LegalPage
  title="Terms — shuv2code"
  description="Terms for using the open-source shuv2code software."
  heading="shuv2code Terms"
  lede="shuv2code is open-source software maintained by shuv1337. The repository's license, not a fictional company agreement, governs copying, modification, and distribution."
  effectiveDate="2026-07-28"
  lastUpdated="2026-07-28"
  sections={sections}
>
  <section id="license">
    <p class="section-number">01</p>
    <h2>Open-source license</h2>
    <p>
      The MIT License in the repository governs the shuv2code source and distributions unless a
      component identifies a different license. Required upstream copyright and license notices are
      preserved.
    </p>
  </section>

  <section id="your-responsibility">
    <p class="section-number">02</p>
    <h2>Your responsibility</h2>
    <p>
      You are responsible for the systems, repositories, credentials, prompts, commands, and agent
      output you connect to shuv2code. Review generated changes and commands before applying them, and
      use the software only where you have authorization.
    </p>
  </section>

  <section id="third-parties">
    <p class="section-number">03</p>
    <h2>Third-party services</h2>
    <p>
      Providers you configure—including coding agents, model APIs, source-control hosts, identity
      services, and app stores—have separate terms. shuv2code does not grant rights to those services
      or change your agreement with them.
    </p>
  </section>

  <section id="alpha">
    <p class="section-number">04</p>
    <h2>Alpha software</h2>
    <p>
      The <code>0.1.0-alpha.1</code> release is prerelease software. Interfaces, storage formats, and
      behavior may change. The software is provided without warranty, as stated in the MIT License.
    </p>
  </section>

  <section id="provenance">
    <p class="section-number">05</p>
    <h2>Project provenance</h2>
    <p>
      shuv2code is a fork of T3 Code. References to T3 Code and its maintainers are retained only
      where needed for attribution, license compliance, notices, and upstream history; they do not
      imply sponsorship or endorsement.
    </p>
  </section>
</LegalPage>
